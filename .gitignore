# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
# build/ is also the default output of scripts/build_corpus.py (--out build/);
# dist/ covers frontend/dist (Vite build output)
build/
dist/

# Virtual environments
.venv/
venv/

# Test and lint caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/
.mypy_cache/

# Node (frontend/ is React + Vite)
node_modules/
npm-debug.log*
*.env
*.env.*
!*.env.example

# OS and editors
.DS_Store
._*
__MACOSX/
.vscode/
.idea/
*.swp
*.log

# AI-assistant working files - authorship of this repository is the author's alone
.claude/

# Local working material, anchored to the repository root so a same-named
# directory elsewhere is never hidden by accident
/HARDENING_LOG.md
/RECONCILIATION_REPORT.md
/provenance_register.html
/WALLETCLASSIFICATION_CASE_STUDY_REPORT.md
# MBAL experiment: the dataset and anything derived from it (samples, screenshots, raw JSON)
# live outside the repository and must never be added; its two reports carry no rows and are tracked
/mbal_testdata/
/mbal_evidence/
mbal_*.csv
dataset_10m_ads*.csv
/results/
/external_data/
/release/

# Databases and archives: third-party datasets are not redistributable
# (THIRD_PARTY_DATA.md) and generated demo DBs are reproducible from scripts/
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.zip

# Vite / frontend caches
frontend/.vite/
*.tsbuildinfo

# The manuscript is the author's paper, not code: never tracked or released
/paper/*.pdf
/paper/manuscript/
